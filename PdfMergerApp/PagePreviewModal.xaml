<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PdfMergerApp.PagePreviewModal"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

	<Grid RowDefinitions="*,Auto">

		<ScrollView Grid.Row="0"
                    x:Name="ImageScrollView">
			<Image x:Name="PreviewImage"
                   Aspect="AspectFit"
                   AnchorX="0.5"
                   AnchorY="0.5"/>
		</ScrollView>

		<HorizontalStackLayout Grid.Row="1"
                               HorizontalOptions="Center"
                               Spacing="12"
                               Margin="0,0,0,30">

			<Button Text="↺" Clicked="RotateLeft_Clicked"
                    HeightRequest="48" WidthRequest="60"/>
			<!--<Button Text="↻" Clicked="RotateRight_Clicked"
                    HeightRequest="48" WidthRequest="60"/>-->
			<Button Text="−" Clicked="ZoomOut_Clicked"
                    HeightRequest="48" WidthRequest="60"
                    FontSize="22"/>
			<Button Text="+" Clicked="ZoomIn_Clicked"
                    HeightRequest="48" WidthRequest="60"
                    FontSize="22"/>
			<Button Text="✕" Clicked="Close_Clicked"
                    HeightRequest="48" WidthRequest="60"
                    TextColor="Red"/>

		</HorizontalStackLayout>

	</Grid>

</ContentPage>