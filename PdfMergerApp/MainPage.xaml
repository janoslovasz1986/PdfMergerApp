<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PdfMergerApp"
             x:Class="PdfMergerApp.MainPage">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <BoxView Grid.Row="0" 
             HeightRequest="50" 
             Color="#F0F0F0"/>

        <!-- Felső rész: két oszlop -->
        <Grid Grid.Row="1" ColumnDefinitions="130,*" Padding="8" ColumnSpacing="8">

            <!-- Bal: fájl lista -->
            <Border Grid.Column="0"
            Stroke="#CCCCCC"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            Padding="4">
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                   Text="Fájlok"
                   FontSize="12"
                   TextColor="Gray"
                   Padding="4,4,4,2"/>
                    <CollectionView x:Name="MyCollectionView" Grid.Row="1">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding ., StringFormat='{0}'}"
                               Padding="8"
                               FontSize="12"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               WidthRequest="110"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- Jobb: oldal preview -->
            <Border Grid.Column="1"
            Stroke="#CCCCCC"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            Padding="4">
                <Grid RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                   Text="Oldalak"
                   FontSize="12"
                   TextColor="Gray"
                   Padding="4,4,4,2"/>
                    <CollectionView x:Name="PagesCollectionView" Grid.Row="1">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="4" VerticalItemSpacing="4"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:PdfPageItem">
                                <Border Stroke="LightGray" StrokeThickness="1" Padding="4" Margin="4">
                                    <VerticalStackLayout>
                                        <Image Source="{Binding Preview}"
                                               HeightRequest="{Binding PreviewHeight}"
                                               Rotation="{Binding Rotation}"
                                               Aspect="AspectFit">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="PreviewImage_Tapped"
                                                         CommandParameter="{Binding .}"/>
                                                </Image.GestureRecognizers>
                                        </Image>
                                        <Label Text="{Binding DisplayName}"
                                       HorizontalOptions="Center"
                                       FontSize="11"/>
                                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                                            <Label Text="▲" FontSize="16"
                                                   Padding="6,2"
                                                   HorizontalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="MovePageUp_Clicked" CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Text="▼" FontSize="16"
                                                   Padding="6,2"
                                                   HorizontalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="MovePageDown_Clicked" CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Text="✕" FontSize="16"
                                                   TextColor="Red"
                                                   Padding="6,2"
                                                   HorizontalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="DeletePage_Clicked" CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

        </Grid>


        <!-- töltésjelző -->
        <VerticalStackLayout Grid.Row="2"
                             x:Name="LoadingOverlay"
                             IsVisible="False"
                             HorizontalOptions="Center">
            <Image x:Name="LoadingIcon"
                   Source="pdficon.png"
                   HeightRequest="100"
                   WidthRequest="100"
                   HorizontalOptions="Center"/>
            <Label Text="PDF összefűzése folyamatban..."
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>
        </VerticalStackLayout>

        <!-- Alsó gombok -->
        <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center">
            <Button x:Name="BtnAddPdf" Text="add pdf" HeightRequest="60" Margin="10" Clicked="selectPdf"/>
            <Button x:Name="BtnClear" Text="clear" HeightRequest="60" Margin="10" Clicked="clearSelection"/>
            <Button x:Name="BtnCreatePdf" Text="create pdf" HeightRequest="60" Margin="10" Clicked="createPdf"/>
            <!--<Button Text="TESZT anim" Clicked="TestAnim_Clicked" HeightRequest="60" Margin="10"/> -->
        </HorizontalStackLayout>

    </Grid>
</ContentPage>