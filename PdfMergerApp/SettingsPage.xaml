<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PdfMergerApp.SettingsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Háttérkép -->
        <Image Source="mergepdf_bg.png"
           Aspect="AspectFill"
           Grid.RowSpan="4"
           Opacity="0.2"/>

        <BoxView Grid.Row="0" HeightRequest="50" Color="#F0F0F0"/>

        <Label x:Name="TitleLabel"
               Grid.Row="1"
               FontSize="20"
               FontAttributes="Bold"
               Padding="20,12,20,8"/>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20" Spacing="0">

                <!-- Fájlnév -->
                <Label x:Name="OutputFileNameLabel" FontSize="13" TextColor="Gray" Margin="0,16,0,4"/>
                <HorizontalStackLayout Spacing="8">
                    <Entry x:Name="FileNameEntry" WidthRequest="220"/>
                    <Label Text=".pdf" VerticalOptions="Center" FontSize="16"/>
                    <Button x:Name="SaveButton" Clicked="SaveSettings_Clicked" HeightRequest="40" Padding="12,0"/>
                </HorizontalStackLayout>
                <Label x:Name="ConfirmLabel" Text="" TextColor="Green" Margin="0,4,0,0" FontSize="13"/>


                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <!-- Automatikus megnyitás -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="AutoOpenLabel" FontSize="16"/>
                        <Label x:Name="AutoOpenDescLabel" FontSize="13" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch x:Name="AutoOpenSwitch" Grid.Column="1" OnColor="Green"
                            Toggled="AutoOpenSwitch_Toggled" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <!-- Nagy preview -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="LargePreviewLabel" FontSize="16"/>
                        <Label x:Name="LargePreviewDescLabel" FontSize="13" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch x:Name="LargePreviewSwitch" Grid.Column="1" OnColor="Green"
                            Toggled="LargePreviewSwitch_Toggled" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <!-- Sötét mód -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="DarkModeLabel" FontSize="16"/>
                        <Label x:Name="DarkModeDescLabel" FontSize="13" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch x:Name="DarkModeSwitch" Grid.Column="1" OnColor="Green"
                            Toggled="DarkModeSwitch_Toggled" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <!-- Jelszóvédelem -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="PasswordLabel" FontSize="16"/>
                        <Label x:Name="PasswordDescLabel" FontSize="13" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch x:Name="PasswordSwitch" Grid.Column="1" OnColor="Green"
                            Toggled="PasswordSwitch_Toggled" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="ImageSizeModeLabel" FontSize="16"/>
                        <Label x:Name="ImageSizeModeDescLabel" FontSize="13" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch x:Name="ImageFitA4Switch"
                        Grid.Column="1"
                        OnColor="Green"
                        Toggled="ImageFitA4Switch_Toggled"
                        VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <!-- Nyelv -->
                <Label x:Name="LanguageLabel" FontSize="16" Margin="0,4,0,8"/>
                <Picker x:Name="LanguagePicker" SelectedIndexChanged="LanguagePicker_Changed">
                    <Picker.Items>
                        <x:String>Magyar</x:String>
                        <x:String>English</x:String>
                        <x:String>Deutsch</x:String>
                        <x:String>Español</x:String>
                    </Picker.Items>
                </Picker>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

                <!-- Kikapcsolás -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="AutoQuitLabel" FontSize="16"/>
                        <Label x:Name="AutoQuitDescLabel" FontSize="13" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Switch x:Name="AutoQuitSwitch" Grid.Column="1" OnColor="Green"
                            Toggled="AutoQuitSwitch_Toggled" VerticalOptions="Center"/>
                </Grid>


            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>