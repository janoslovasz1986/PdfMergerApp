<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PdfMergerApp.SettingsPage"
             Title="Beállítások">

	<VerticalStackLayout Padding="20" Spacing="10">

		<Label Text="Kimeneti fájl neve" FontSize="16"/>
		<HorizontalStackLayout Spacing="8">
			<Entry x:Name="FileNameEntry"
                   Placeholder="pl. merged_doc"
                   WidthRequest="220"/>
			<Label Text=".pdf"
                   VerticalOptions="Center"
                   FontSize="16"/>
		</HorizontalStackLayout>

		<BoxView HeightRequest="1" Color="LightGray" Margin="0,8"/>

		<Label Text="Rezgés kész PDF után" FontSize="16"/>
		<Switch x:Name="VibrateSwitch" Toggled="VibrateSwitch_Toggled"/>

		<BoxView HeightRequest="1" Color="LightGray" Margin="0,8"/>

        <Label Text="Kész PDF automatikus megnyitása" FontSize="16" Margin="0,20,0,0"/>

        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Switch x:Name="AutoOpenSwitch" IsToggled="False" Toggled="AutoOpenSwitch_Toggled"/>
            <Label x:Name="AutoOpenLabel" Text="Kikapcsolva" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Button Text="Mentés"
                Clicked="SaveSettings_Clicked"
                Margin="0,10,0,0"/>

		<Label x:Name="ConfirmLabel"
               Text=""
               TextColor="Green"/>

	</VerticalStackLayout>

</ContentPage>