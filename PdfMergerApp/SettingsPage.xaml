<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PdfMergerApp.SettingsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Felső banner sáv -->
        <BoxView Grid.Row="0"
                 HeightRequest="50"
                 Color="#F0F0F0"/>

        <!-- Cím -->
        <Label Grid.Row="1"
               Text="Beállítások"
               FontSize="20"
               FontAttributes="Bold"
               Padding="20,12,20,8"/>

        <!-- Tartalom -->
        <VerticalStackLayout Grid.Row="2" Padding="20" Spacing="0">

            <!-- Fájlnév -->
            <Label Text="Kimeneti fájl neve" FontSize="13" TextColor="Gray" Margin="0,16,0,4"/>
            <HorizontalStackLayout Spacing="8">
                <Entry x:Name="FileNameEntry"
                       Placeholder="pl. merged_doc"
                       WidthRequest="220"/>
                <Label Text=".pdf" VerticalOptions="Center" FontSize="16"/>
                <Button Text="Mentés"
                        Clicked="SaveSettings_Clicked"
                        HeightRequest="40"
                        Padding="12,0"/>
            </HorizontalStackLayout>
            <Label x:Name="ConfirmLabel" Text="" TextColor="Green" Margin="0,4,0,0" FontSize="13"/>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

            <!-- Rezgés -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Rezgés" FontSize="16"/>
                    <Label Text="Értesítés rezgéssel ha kész a PDF" FontSize="13" TextColor="Gray"/>
                </VerticalStackLayout>
                <Switch x:Name="VibrateSwitch"
                        Grid.Column="1"
                        Toggled="VibrateSwitch_Toggled"
                        VerticalOptions="Center"/>
            </Grid>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

            <!-- Automatikus megnyitás -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Automatikus megnyitás" FontSize="16"/>
                    <Label Text="Kész PDF megnyitása mentés után" FontSize="13" TextColor="Gray"/>
                </VerticalStackLayout>
                <Switch x:Name="AutoOpenSwitch"
                        Grid.Column="1"
                        Toggled="AutoOpenSwitch_Toggled"
                        VerticalOptions="Center"/>
            </Grid>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,16"/>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Nagy preview" FontSize="16"/>
                    <Label Text="Nagyobb oldal előnézet a főoldalon" FontSize="13" TextColor="Gray"/>
                </VerticalStackLayout>
                <Switch x:Name="LargePreviewSwitch"
                        Grid.Column="1"
                        Toggled="LargePreviewSwitch_Toggled"
                        VerticalOptions="Center"/>
            </Grid>

        </VerticalStackLayout>

    </Grid>

</ContentPage>